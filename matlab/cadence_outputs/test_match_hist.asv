error_matrix = 0.5 * eye(L_algo) + ...
    -0.25 * diag(ones(L_algo-1,1), 1) + ...
    -0.25 * diag(ones(L_algo-1,1), -1);

(error_matrix + lambda_reg*eye(L_algo))\H_delta;