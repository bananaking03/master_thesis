// 					);
// 				end
// 			end
// 		end
// 	endgenerate

// 	// Establish the lower endpoint when no unary units are enabled.
// 	analog begin
// 		@cross(V(enable), venable_threshold) begin
// 			if (V(enable) < venable_threshold) begin
// 				Vsample = V(vout);
// 			end
// 		end
// 	end
// endmodule

