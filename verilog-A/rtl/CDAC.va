// 	parameter real td = 0.0;                // Output delay.
// 	parameter real trise = 1p;              // Output rise time.
// 	parameter real tfall = 1p;              // Output fall time.

// 	// Fixed width keeps the symbol generator independent of N_BITS.
// 	// The first 2**N_BITS bits are used; maximum supported N_BITS is 10.
// 	input [1023:0] ctrl;                  // One electrical control per unit.
// 	input sample_clk;                      // Sample clock for the CDAC.
// 	input enable, Vref, gnd;                       // Enables the CDAC output.
// 	inout vout;                        // CDAC output voltage.
// 	electrical [1023:0] ctrl;            // Preserve the control bus width.
// 	electrical sample, vout;

// 	genvar unit;

// 	// Each enabled unit contributes one equal voltage increment.
// 	// A compile-time generate index is required for analog vector access.
// 	generate
// 		for (unit = 0; unit < (1 << N_BITS); unit = unit + 1) begin : gen_unit
// 			analog begin
